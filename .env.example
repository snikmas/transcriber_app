# Safe default: deterministic offline portfolio demo.
TRANSCRIBER_MODE=demo

# Use "local" to run actual faster-whisper transcription.
# The configured model downloads on the first local-mode job unless it is cached.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_OFFLINE=false

DATABASE_PATH=data/jobs.sqlite3
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=100
POLL_INTERVAL_SECONDS=0.5

# Meeting analysis defaults are deterministic and offline-safe.
ANALYSIS_MODE=demo
ANALYSIS_PROVIDER=demo
ANALYSIS_PROTOCOL=demo
ANALYSIS_MODEL=deterministic-meeting-v1
# Required for PackyAPI or a custom provider; use the endpoint from the account docs.
ANALYSIS_BASE_URL=
ANALYSIS_OUTPUT_LANGUAGE=auto
ANALYSIS_TIMEOUT_SECONDS=60
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_CHUNK_CHARS=12000
ANALYSIS_MAX_CHUNKS=10
ANALYSIS_MAX_TRANSCRIPT_CHARS=120000
CUSTOM_PROVIDER_POLICY=local-only
ALLOW_LOCAL_PROVIDER_URLS=false

# Optional environment-backed live-provider keys. Leave blank; never commit real credentials.
# UI-entered keys are one-time request inputs and are not persisted.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
PACKYAPI_API_KEY=
ANALYSIS_API_KEY=

# Streamlit uses localhost outside Docker. Compose overrides this with api:8000.
API_URL=http://localhost:8000
