# Real local speech recognition. The model downloads on first use if needed.
TRANSCRIBER_MODE=local

# The configured model downloads on the first job unless it is cached.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_OFFLINE=false

DATABASE_PATH=data/jobs.sqlite3
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=100
POLL_INTERVAL_SECONDS=0.5

# Choose a live provider and configure its backend-only key below.
ANALYSIS_MODE=live
ANALYSIS_PROVIDER=deepseek
ANALYSIS_PROTOCOL=openai_chat
ANALYSIS_MODEL=deepseek-v4-flash
# Required only for a custom provider; presets use their official endpoints.
ANALYSIS_BASE_URL=
ANALYSIS_OUTPUT_LANGUAGE=auto
ANALYSIS_TIMEOUT_SECONDS=60
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_CHUNK_CHARS=12000
ANALYSIS_MAX_CHUNKS=10
ANALYSIS_MAX_TRANSCRIPT_CHARS=120000
CUSTOM_PROVIDER_POLICY=local-only
ALLOW_LOCAL_PROVIDER_URLS=false

# Backend-only live-provider keys. Never commit real credentials. The UI and
# public API request model do not accept provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANALYSIS_API_KEY=

# Streamlit uses localhost outside Docker. Compose overrides this with api:8000.
API_URL=http://localhost:8000
